PORT=8000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pawpaw
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
OPENAI_MODEL=gpt-5.4-nano
JWT_SECRET=your_jwt_secret_here
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/login/kakao/callback
# 배포 시에만 설정: 배포된 프론트엔드 origin (CORS 허용 목록에 추가됨). 로컬 개발엔 불필요.
FRONTEND_ORIGIN=
# AI 호출 모드 (SPEC.md §7.6/7.7): live(실제 호출, 응답을 재생용으로 기록) / mock(목업, 개발기 권장) / replay(기록된 응답 재생, 시연용)
AI_MODE=live
# 월간 토큰 한도 (SPEC.md §7.8). 0이면 사용량 기록만 하고 차단하지 않음
AI_MONTHLY_TOKEN_LIMIT=0
AI_QUOTA_SAFETY_RATIO=0.9
# 사용자 1명당 하루 AI 상담 횟수 (캐시 응답 제외). 0이면 제한 없음
CHAT_DAILY_LIMIT_PER_USER=20
